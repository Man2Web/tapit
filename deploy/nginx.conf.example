# Nginx reverse proxy for apps/web (Next.js, run via PM2 on port 3000 —
# see deploy/ecosystem.config.js).
#
# Copy to /etc/nginx/sites-available/tapit, symlink into sites-enabled,
# replace YOUR_DOMAIN, then run `certbot --nginx -d YOUR_DOMAIN` to add
# TLS (it rewrites this file to add the 443 server block automatically).

server {
    listen 80;
    server_name YOUR_DOMAIN;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
